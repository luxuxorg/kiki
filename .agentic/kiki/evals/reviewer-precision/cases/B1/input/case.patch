+  if (hasSecretSegment(realRelative) || hasSecretSegment(relative(checkout, realParent))) {
+    throw new Error(
+      `release: refusing candidate: tracked path '${relativePath}' resolves through a secret-bearing path ('${realRelative}').`,
+    );
+  }
