+    expect(rejected[0]?.severity).toBe(2);
+
+    const accepted = unusedVarDiagnostics(
+      await lint(
+        'export function catchesIgnored() { try { throw new Error("x"); } catch (_ignoredError) { return 1; } }\n',
+      ),
+    );
+    expect(accepted).toEqual([]);
+  });
+});
