+    if (!translated.ok) return { ok: false, reason: translated.reason };
+    permissions = translated.rules;
+  }
+  return {
+    ok: true,
+    value: {
+      ...(model.model ? { model: model.model } : {}),
+      ...(permissions !== undefined ? { permissions } : {}),
+    },
+  };
+}
+
