+function mergeConfigSettings(base: Settings, extra: Settings): Settings {
+  const result = { ...base };
+  for (const [key, value] of Object.entries(extra)) {
+    if (FORBIDDEN_KEYS.has(key)) throw new Error('Invalid configuration key');
+    if (key === 'agent' || key === 'agents') {
