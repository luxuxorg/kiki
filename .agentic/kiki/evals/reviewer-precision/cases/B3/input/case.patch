+    expect(effectFor(project, 'edit', 'spec/a.test.ts')).toBe('allow');
+    expect(project.some(rule =>
+      rule.action === 'edit' && rule.resource === 'outside/**' && rule.effect === 'allow')).toBe(false);
+  });
+});
