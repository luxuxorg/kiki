new file mode 100644
index 0000000..1385de5
--- /dev/null
+++ b/src/cli/oc2-permissions.ts
@@ -0,0 +1,130 @@
+import type { PermissionRule } from './opencode-config.js';
+
+export type PermissionResult =
+  | { ok: true; rules: PermissionRule[] }
+  | { ok: false; reason: string };
+
+type Effect = PermissionRule['effect'];
+
+/** Verified V1 action keys. Unknown keys are rejected instead of guessed. */
+const KNOWN_ACTIONS = new Set([
+  'read', 'edit', 'glob', 'grep', 'list', 'bash', 'task', 'external_directory',
+  'todowrite', 'question', 'webfetch', 'websearch', 'lsp', 'doom_loop', 'skill',
+  'write', 'patch', 'apply_patch',
+]);
+
+const ACTION_ALIASES: Record<string, string> = {
+  write: 'edit',
+  patch: 'edit',
+  apply_patch: 'edit',
+  task: 'subagent',
+  bash: 'shell',
+};
+
+const EFFECTS = new Set<Effect>(['allow', 'deny', 'ask']);
+const FORBIDDEN_KEYS = new Set(['__proto__', 'constructor', 'prototype']);
+
+function isPlainObject(value: unknown): value is Record<string, unknown> {
+  if (typeof value !== 'object' || value === null || Array.isArray(value)) return false;
+  const prototype = Object.getPrototypeOf(value);
+  return prototype === Object.prototype || prototype === null;
+}
+
+function fail(reason: string): PermissionResult {
+  return { ok: false, reason };
+}
+
+function translateValue(action: string, value: unknown): PermissionResult {
+  if (typeof value === 'string') {
+    if (!EFFECTS.has(value as Effect)) return fail('Invalid permission effect.');
+    return { ok: true, rules: [{ action, resource: '*', effect: value as Effect }] };
+  }
+  if (!isPlainObject(value)) return fail('Invalid permission configuration.');
+  const rules: PermissionRule[] = [];
+  for (const [resource, effect] of Object.entries(value)) {
+    if (FORBIDDEN_KEYS.has(resource)) return fail('Invalid permission resource.');
+    if (!resource.trim()) return fail('Invalid permission resource.');
+    if (typeof effect !== 'string' || !EFFECTS.has(effect as Effect)) {
+      return fail('Invalid permission effect.');
+    }
+    rules.push({ action, resource, effect: effect as Effect });
+  }
+  return { ok: true, rules };
+}
+
+function canonical(rules: PermissionRule[]): string {
+  return JSON.stringify(rules
+    .map(rule => [rule.resource, rule.effect])
+    .sort((left, right) => left[0].localeCompare(right[0]) || left[1].localeCompare(right[1])));
+}
+
+/** Map a V1 permission map (or absence) into ordered native rules. */
+export function translatePermissions(input: unknown): PermissionResult {
+  if (input === undefined) return { ok: true, rules: [] };
+  if (!isPlainObject(input)) return fail('Invalid permission configuration.');
+
+  // Multiple V1 tool keys that collapse onto one native action cannot keep
+  // separate defaults. Only identical rule sets are faithfully representable.
+  const groups = new Map<string, { key: string; rules: PermissionRule[] }[]>();
+  for (const [key, value] of Object.entries(input)) {
+    if (FORBIDDEN_KEYS.has(key)) return fail('Invalid permission action.');
+    if (!KNOWN_ACTIONS.has(key)) return fail(`Unknown permission action: ${key}`);
+    const action = ACTION_ALIASES[key] ?? key;
+    const translated = translateValue(action, value);
+    if (!translated.ok) return translated;
+    groups.set(action, [...(groups.get(action) ?? []), { key, rules: translated.rules }]);
+  }
+
+  const rules: PermissionRule[] = [];
+  for (const [action, sources] of groups) {
+    if (sources.length > 1) {
+      const first = canonical(sources[0].rules);
+      if (sources.slice(1).some(source => canonical(source.rules) !== first)) {
+        return fail(`Conflicting permission aliases for action: ${action}`);
+      }
+    }
+    for (const rule of sources[0].rules) rules.push({ ...rule, action });
+  }
+  return { ok: true, rules };
+}
+
+/**
+ * Build the project-level rules appended after inherited (global) rules.
+ * Omitted inherited grants are narrowed to the local fallback; inherited
+ * deny/ask rules are never relaxed into allow.
+ */
+export function projectPermissionRules(local: PermissionRule[], inherited: PermissionRule[]): PermissionRule[] {
+  const result = local.map(rule => ({ ...rule }));
+  const localEffects = new Map<string, Effect>();
+  for (const rule of local) localEffects.set(`${rule.action}\0${rule.resource}`, rule.effect);
+  const fallback = (action: string): Effect => {
+    for (let index = local.length - 1; index >= 0; index--) {
+      const rule = local[index];
+      if (rule.action === action && rule.resource === '*') return rule.effect;
+    }
+    return 'ask';
+  };
+
+  for (const rule of inherited) {
+    const key = `${rule.action}\0${rule.resource}`;
+    const localEffect = localEffects.get(key);
+    if (localEffect !== undefined) {
+      // Project rules are appended after inherited ones, so a local allow
+      // would otherwise override an inherited deny/ask for the same resource.
+      if (rule.effect === 'deny' && localEffect !== 'deny') {
+        result.push({ action: rule.action, resource: rule.resource, effect: 'deny' });
+      } else if (rule.effect === 'ask' && localEffect === 'allow') {
+        result.push({ action: rule.action, resource: rule.resource, effect: 'ask' });
+      }
+      continue;
+    }
+    const localFallback = fallback(rule.action);
+    const effect: Effect = rule.effect === 'deny'
+      ? 'deny'
+      : rule.effect === 'ask'
+        ? (localFallback === 'allow' ? 'ask' : localFallback)
+        : localFallback;
+    result.push({ action: rule.action, resource: rule.resource, effect });
+  }
+  return result;
+}
diff --git a/src/cli/oc2-registration.ts b/src/cli/oc2-registration.ts
new file mode 100644
index 0000000..7d6a3bb
--- /dev/null
+++ b/src/cli/oc2-registration.ts
@@ -0,0 +1,261 @@
+import {
+  existsSync, mkdirSync, readFileSync, renameSync, statSync, unlinkSync, writeFileSync,
+} from 'fs';
+import { dirname, isAbsolute, join, resolve, sep } from 'path';
+import { homedir } from 'os';
+import { randomUUID } from 'crypto';
+import { fileURLToPath } from 'url';
+import { applyEdits, modify, parse as parseJsonc, ParseError } from 'jsonc-parser';
+import { assertNotOC1Config, canonicalPath } from './oc2-paths.js';
+
+const SERVER_CONFIG_NAMES = ['opencode.json', 'opencode.jsonc'];
+const CLI_CONFIG_NAMES = ['cli.json', 'cli.jsonc'];
+const KIKI_PACKAGE_NAME = 'kiki';
+const BACKUP_DIRECTORY = 'kiki/backups';
+
+export interface RegistrationPlan {
+  /** Files whose content changes; absent targets are included. */
+  files: string[];
+  apply(): void;
+}
+
+export interface PluginSource {
+  file: string;
+  entry: unknown;
+}
+
+type Settings = Record<string, any>;
+
+function object(value: unknown): value is Settings {
+  return !!value && typeof value === 'object' && !Array.isArray(value);
+}
+
+function pluginSpec(entry: unknown): string | undefined {
+  if (typeof entry === 'string') return entry;
+  if (Array.isArray(entry) && typeof entry[0] === 'string') return entry[0];
+  if (object(entry) && typeof entry.package === 'string') return entry.package;
+  return undefined;
+}
+
+/** Known Kiki package names, versions, local directories and V1 source files. */
+export function isKikiPluginEntry(
+  entry: unknown,
+  activePackageSpec: string = currentPackageSpec(),
+): boolean {
+  const spec = pluginSpec(entry);
+  if (spec === undefined) return false;
+  const clean = spec.split('#')[0].split('?')[0].replace(/\\/g, '/');
+  if (clean === KIKI_PACKAGE_NAME || clean.startsWith(`${KIKI_PACKAGE_NAME}@`)) return true;
+  if (isAbsolute(clean) && samePackageSpec(clean, activePackageSpec)) return true;
+  const name = clean.split('/').filter(Boolean).pop() || '';
+  return name === KIKI_PACKAGE_NAME || name === 'kiki.ts' || name === 'kiki.js'
+    || name.startsWith(`${KIKI_PACKAGE_NAME}@`);
+}
+
+function samePackageSpec(first: string, second: string): boolean {
+  if (first === second) return true;
+  if (isAbsolute(first) && isAbsolute(second)) return canonicalPath(first) === canonicalPath(second);
+  return false;
+}
+
+function readConfig(file: string): Settings | undefined {
+  if (!existsSync(file)) return undefined;
+  const errors: ParseError[] = [];
+  const data = parseJsonc(readFileSync(file, 'utf8'), errors, { allowTrailingComma: true });
+  if (errors.length || !object(data) || Object.getPrototypeOf(data) !== Object.prototype) {
+    throw new Error(`Invalid OpenCode configuration: ${file}`);
+  }
+  for (const key of ['plugins', 'plugin']) {
+    if (data[key] === undefined) continue;
+    if (!Array.isArray(data[key])) throw new Error(`Invalid plugin configuration: ${file}`);
+    for (const entry of data[key]) {
+      if (pluginSpec(entry) === undefined) throw new Error(`Invalid plugin entry: ${file}`);
+    }
+  }
+  return data;
+}
+
+function configFiles(directory: string, names: readonly string[]): string[] {
+  return names.map(name => join(directory, name)).filter(existsSync);
+}
+
+function targetConfig(directory: string, names: readonly string[], fallback: string): string {
+  return configFiles(directory, names).at(-1) ?? join(directory, fallback);
+}
+
+function patchValue(text: string, path: string[], value: unknown): string {
+  let current: any = parseJsonc(text);
+  for (const key of path) current = current?.[key];
+  if (JSON.stringify(current) === JSON.stringify(value)) return text;
+  return applyEdits(text, modify(text, path, value, {
+    formattingOptions: { insertSpaces: true, tabSize: 2 },
+  }));
+}
+
+function writeAtomic(file: string, content: string): void {
+  mkdirSync(dirname(file), { recursive: true });
+  const temp = `${file}.${randomUUID()}.tmp`;
+  try {
+    writeFileSync(temp, content, { mode: existsSync(file) ? statSync(file).mode & 0o777 : 0o600 });
+    renameSync(temp, file);
+  } finally {
+    if (existsSync(temp)) unlinkSync(temp);
+  }
+}
+
+function backupFiles(files: string[], directory: string): void {
+  const existing = [...new Set(files.filter(existsSync))];
+  if (!existing.length) return;
+  const target = join(directory, BACKUP_DIRECTORY, randomUUID());
+  mkdirSync(target, { recursive: true, mode: 0o700 });
+  writeFileSync(join(directory, BACKUP_DIRECTORY, '.gitignore'), '*\n', { mode: 0o600 });
+  for (const [index, file] of existing.entries()) {
+    writeFileSync(join(target, `${index}-${file.split(/[\\/]/).pop()}`), readFileSync(file), { mode: 0o600 });
+  }
+  writeFileSync(join(target, 'manifest.json'), JSON.stringify(existing, null, 2), { mode: 0o600 });
+}
+
+function newServerConfig(): string {
+  return '{\n  "$schema": "https://opencode.ai/config.json"\n}\n';
+}
+
+function guard(directory: string): void {
+  // Installation/update may own a stale V1 artifact in an isolated root; the
+  // machine-default credential boundary is never relaxed.
+  assertNotOC1Config(canonicalPath(directory), homedir(), { allowKnownV1Artifacts: true });
+}
+
+function collectConfigSources(directory: string, names: readonly string[]): PluginSource[] {
+  const result: PluginSource[] = [];
+  for (const file of configFiles(directory, names)) {
+    const settings = readConfig(file);
+    if (!settings) continue;
+    for (const key of ['plugins', 'plugin']) {
+      const entries = settings[key];
+      if (!Array.isArray(entries)) continue;
+      for (const entry of entries) {
+        if (isKikiPluginEntry(entry)) result.push({ file, entry });
+      }
+    }
+  }
+  return result;
+}
+
+/** Kiki package entries configured in server opencode.json(c) files. */
+export function kikiServerSources(directory: string): PluginSource[] {
+  return collectConfigSources(directory, SERVER_CONFIG_NAMES);
+}
+
+/** Kiki package entries configured in cli.json(c) files. */
+export function kikiCliSources(directory: string): PluginSource[] {
+  return collectConfigSources(directory, CLI_CONFIG_NAMES);
+}
+
+/** Auto-discovered V1 source files that OC2 would load alongside a package entry. */
+export function autoDiscoveredKikiPlugins(directory: string): string[] {
+  return ['plugin', 'plugins'].flatMap(folder =>
+    ['kiki.ts', 'kiki.js'].map(file => join(directory, folder, file))).filter(existsSync);
+}
+
+export function hasKikiServerRegistration(directory: string): boolean {
+  return kikiServerSources(directory).length > 0;
+}
+
+export function hasKikiCliRegistration(directory: string): boolean {
+  return kikiCliSources(directory).length > 0;
+}
+
+export function currentPackageDirectory(): string {
+  return resolve(dirname(fileURLToPath(import.meta.url)), '../..');
+}
+
+/**
+ * Development/checkout installations use the absolute package directory; a
+ * package-managed installation uses its package name for `opencode plugin add`.
+ */
+export function currentPackageSpec(): string {
+  const root = currentPackageDirectory();
+  let name = KIKI_PACKAGE_NAME;
+  try {
+    const parsed = JSON.parse(readFileSync(join(root, 'package.json'), 'utf8'));
+    if (object(parsed) && typeof parsed.name === 'string' && parsed.name.trim()) name = parsed.name.trim();
+  } catch {
+    // Fall back to the fixed package name.
+  }
+  return root.split(sep).includes('node_modules') ? name : root;
+}
+
+function registrationEntry(
+  directory: string,
+  names: readonly string[],
+  fallback: string,
+  packageSpec: string,
+  defaultText: string,
+): { file: string; text: string } | undefined {
+  const sources = collectConfigSources(directory, names);
+  if (sources.length > 1) {
+    throw new Error('Duplicate Kiki plugin registration. Remove the extra entry before installing.');
+  }
+  if (sources.length === 1) {
+    const existing = pluginSpec(sources[0].entry)!;
+    if (!samePackageSpec(existing, packageSpec)) {
+      throw new Error('Conflicting Kiki plugin registration. Remove the existing entry before installing.');
+    }
+    return undefined;
+  }
+
+  const file = targetConfig(directory, names, fallback);
+  const before = existsSync(file) ? readFileSync(file, 'utf8') : defaultText;
+  const settings = readConfig(file) ?? {};
+  const current = Array.isArray(settings.plugins) ? settings.plugins : [];
+  // Appending at the array tail preserves comments inside existing entries.
+  const text = Array.isArray(settings.plugins)
+    ? applyEdits(before, modify(before, ['plugins', -1], packageSpec, {
+      isArrayInsertion: true,
+      formattingOptions: { insertSpaces: true, tabSize: 2 },
+    }))
+    : patchValue(before, ['plugins'], [...current, packageSpec]);
+  return text === before && existsSync(file) ? undefined : { file, text };
+}
+
+/**
+ * Plan once-only package registration for the server plugin and the TUI plugin.
+ * Conflicting entries are refused instead of silently replaced.
+ */
+export function prepareRegistration(directory: string, packageSpec: string): RegistrationPlan {
+  if (typeof packageSpec !== 'string' || !packageSpec.trim()) throw new Error('Invalid Kiki package specification.');
+  guard(directory);
+  const server = registrationEntry(directory, SERVER_CONFIG_NAMES, 'opencode.jsonc', packageSpec, newServerConfig());
+  const cli = registrationEntry(directory, CLI_CONFIG_NAMES, 'cli.json', packageSpec, '{}\n');
+  const writes = [server, cli].filter((entry): entry is { file: string; text: string } => entry !== undefined);
+  return {
+    files: writes.map(entry => entry.file),
+    apply() {
+      for (const write of writes) writeAtomic(write.file, write.text);
+    },
+  };
+}
+
+/** Remove only known Kiki entries; unrelated plugins and comments survive. */
+export function removeKikiRegistration(directory: string): void {
+  guard(directory);
+  const changes: { file: string; text: string }[] = [];
+  for (const names of [SERVER_CONFIG_NAMES, CLI_CONFIG_NAMES]) {
+    for (const file of configFiles(directory, names)) {
+      const before = readFileSync(file, 'utf8');
+      const settings = readConfig(file) ?? {};
+      let text = before;
+      for (const key of ['plugins', 'plugin']) {
+        const entries = settings[key];
+        if (!Array.isArray(entries)) continue;
+        const filtered = entries.filter(entry => !isKikiPluginEntry(entry));
+        if (filtered.length === entries.length) continue;
+        text = patchValue(text, [key], filtered.length ? filtered : undefined);
+      }
+      if (text !== before) changes.push({ file, text });
+    }
+  }
+  if (!changes.length) return;
+  backupFiles(changes.map(change => change.file), directory);
+  for (const change of changes) writeAtomic(change.file, change.text);
+}
