+import { assertNotOC1Config, canonicalPath, pathsOverlap } from './oc2-paths.js';
+import { projectPermissionRules, translatePermissions } from './oc2-permissions.js';
+import { KIKI_VERSION } from './config.js';
+
+export interface MigrationOptions {
+  from?: string;
+  project?: string;
+  force: boolean;
+  destination: string;
+}
+
+export interface MigrationReport {
+  migrated: string[];
+  rejected: { agent: string; reason: string }[];
+  manual: string[];
+  marker?: string;
+  exitCode: 0 | 1;
+}
+
+interface AgentValue {
+  model?: ModelSelection;
+  permissions?: PermissionRule[];
+}
+
+interface SourceAgentDefinition {
+  value: unknown;
+  file: string;
+  section: 'agent' | 'agents';
+}
+
+type ModelResult = { ok: true; model?: ModelSelection } | { ok: false; reason: string };
+type AgentResult = { ok: true; value: AgentValue } | { ok: false; reason: string };
+
+const FORBIDDEN_KEYS = new Set(['__proto__', 'constructor', 'prototype']);
+const PLUGIN_DIRECTORIES = ['plugin', 'plugins'];
+const AGENT_DIRECTORIES = ['agent', 'agents'];
+const CONFIG_NAMES = ['opencode.json', 'opencode.jsonc'];
+
+function object(value: unknown): value is Settings {
+  return !!value && typeof value === 'object' && !Array.isArray(value);
+}
+
+function plainObject(value: unknown): value is Settings {
+  if (!object(value)) return false;
+  const prototype = Object.getPrototypeOf(value);
+  return prototype === Object.prototype || prototype === null;
+}
+
+/** V1's global config resolution: XDG_CONFIG_HOME or ~/.config, never OC2 overrides. */
+export function oc1GlobalDirectory(env: NodeJS.ProcessEnv = process.env, home: string = homedir()): string {
+  return join(env.XDG_CONFIG_HOME || join(home, '.config'), 'opencode');
+}
+
+function configCandidates(directory: string, global: boolean): string[] {
+  const names = global
+    ? CONFIG_NAMES
