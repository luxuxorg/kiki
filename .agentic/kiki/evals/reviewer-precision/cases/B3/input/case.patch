+  fixture: ReturnType<typeof createOC2Fixture>,
+  session: string,
+): Record<string, any> {
+  const result = fixture.run(['session', 'export', session, '--sanitize', '--standalone']);
+  expect(result.status, result.stderr).toBe(0);
+  return JSON.parse(result.stdout);
