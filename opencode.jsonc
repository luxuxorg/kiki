{
  "$schema": "https://opencode.ai/config.json",
  "agent": {
    "kiki-orchestrator": {
      "model": "deepseek/deepseek-flash"
      //"model": "mistral/mistral-large-4"
    },
    "kiki-brainstormer": {
      "permission": {
        "read": {
          "*": "allow",
          ".env*": "deny",
          "**/.env*": "deny",
          "**/*secret*": "deny",
          "**/*credential*": "deny",
          "**/*.pem": "deny",
          "**/*.key": "deny",
          "**/id_rsa*": "deny"
        },
        "edit": {
          "*": "deny",
          "src/**": "deny",
          "tests/**": "deny",
          "docs/superpowers/**": "allow",
          "docs/superpowers/plans/**": "allow",
          "docs/superpowers/specs/**": "allow",
          ".worktree/**/docs/superpowers/**": "allow",
          ".worktree/**/docs/superpowers/plans/**": "allow",
          ".worktree/**/docs/superpowers/specs/**": "allow"
        },
        "bash": {
          "*": "deny",
          "git diff*": "allow",
          "git log*": "allow",
          "git status*": "allow",
          "git show*": "allow",
          "git ls-files*": "allow",
          "git rev-parse*": "allow",
          "git ls-tree*": "allow",
          "git rev-list*": "allow",
          "mkdir*": "allow"
        }
      }//,
      //"model": "mistral/mistral-large-4"
    },
    "kiki-planner": {
      "permission": {
        "read": {
          "*": "allow",
          ".env*": "deny",
          "**/.env*": "deny",
          "**/*secret*": "deny",
          "**/*credential*": "deny",
          "**/*.pem": "deny",
          "**/*.key": "deny",
          "**/id_rsa*": "deny"
        },
        "edit": {
          "*": "deny",
          "src/**": "deny",
          "tests/**": "deny",
          "docs/superpowers/**": "allow",
          "docs/superpowers/plans/**": "allow",
          "docs/superpowers/specs/**": "allow",
          ".worktree/**/docs/superpowers/**": "allow",
          ".worktree/**/docs/superpowers/plans/**": "allow",
          ".worktree/**/docs/superpowers/specs/**": "allow"
        },
        "bash": {
          "*": "deny",
          "git diff*": "allow",
          "git log*": "allow",
          "git status*": "allow",
          "git show*": "allow",
          "git ls-files*": "allow",
          "git rev-parse*": "allow",
          "git ls-tree*": "allow",
          "git rev-list*": "allow",
          "mkdir*": "allow"
        }
      }//,
      //"model": "openai/gpt-6.1-sol"
    },
    "kiki-implementer": {
      "permission": {
        "read": {
          "*": "allow",
          ".env*": "deny",
          "**/.env*": "deny",
          "**/*secret*": "deny",
          "**/*credential*": "deny",
          "**/*.pem": "deny",
          "**/*.key": "deny",
          "**/id_rsa*": "deny"
        },
        "edit": {
          "*": "deny",
          "docs/superpowers/**": "deny",
          "src/**": "allow",
          "tests/**": "allow",
          // Migration tooling and evidence owned by the backend implementer.
          "package.json": "allow",
          "package-lock.json": "allow",
          "tsconfig.json": "allow",
          "eslint.config.mjs": "allow",
          ".gitignore": "allow",
          ".npmignore": "allow",
          // Authorized cleanup of retired V1 generated plugin artifacts only.
          "dist/plugin/dedup-source.js": "allow",
          "dist/plugin/dedup-source.js.map": "allow",
          "dist/plugin/dedup-source.d.ts": "allow",
          "dist/plugin/dedup-source.d.ts.map": "allow",
          "dist/plugin/watchdog-source.js": "allow",
          "dist/plugin/watchdog-source.js.map": "allow",
          "dist/plugin/watchdog-source.d.ts": "allow",
          "dist/plugin/watchdog-source.d.ts.map": "allow",
          "docs/migrations/kiki-3-oc2-api-contract.md": "allow",
          "docs/migrations/kiki-3-oc2-acceptance.md": "allow",
          ".worktree/**/src/**": "allow",
          ".worktree/**/tests/**": "allow",
          "/tmp/**": "allow",
          "tmp/**": "allow"
        },
        "external_directory": {
          "/tmp/**": "allow",
          "tmp/**": "allow"
        },
        "bash": "allow"
      }//,
      //"model": "deepseek/DeepSeek-V4.1-Flash-1017"
    },
    "kiki-gui-designer": {
      "permission": {
        "read": {
          "*": "allow",
          ".env*": "deny",
          "**/.env*": "deny",
          "**/*secret*": "deny",
          "**/*credential*": "deny",
          "**/*.pem": "deny",
          "**/*.key": "deny",
          "**/id_rsa*": "deny"
        },
        "edit": {
          "*": "deny",
          "docs/superpowers/**": "deny",
          "src/**": "allow",
          "tests/**": "allow",
          ".worktree/**/src/**": "allow",
          ".worktree/**/tests/**": "allow",
          "/tmp/**": "allow",
          "tmp/**": "allow"
        },
        "external_directory": {
          "/tmp/**": "allow",
          "tmp/**": "allow"
        },
        "bash": "allow"
      }//,
      //"model": "openrouter/z-ai/glm-5.3"
    },
    "kiki-reviewer": {
      "permission": {
        "read": {
          "*": "allow",
          ".env*": "deny",
          "**/.env*": "deny",
          "**/*secret*": "deny",
          "**/*credential*": "deny",
          "**/*.pem": "deny",
          "**/*.key": "deny",
          "**/id_rsa*": "deny"
        },
        "edit": {
          "*": "deny",
          "src/**": "deny",
          "tests/**": "deny",
          "docs/**": "deny",
          ".agentic/reviews/*": "allow",
          ".opencode/docs/reviews/*": "allow",
          ".worktree/**/.agentic/reviews/*": "allow",
          ".worktree/**/.opencode/docs/reviews/*": "allow"
        },
        "external_directory": {
          "/tmp/**": "allow",
          "tmp/**": "allow"
        },
        "bash": {
          "*": "deny",
          "git diff*": "allow",
          "git log*": "allow",
          "git status*": "allow",
          "git show*": "allow",
          "git ls-files*": "allow",
          "git rev-parse*": "allow",
          "git ls-tree*": "allow",
          "git rev-list*": "allow",
          // Execute project verification; source edits remain role-restricted.
          "npm test*": "allow",
          "npm run build*": "allow",
          "npm run lint*": "allow",
          "npm audit*": "allow",
          "npm pack*": "allow",
          "npm ci --ignore-scripts*": "allow",
          "npm install --ignore-scripts --omit=dev*": "allow",
          "npx --no-install vitest*": "allow",
          "OPENCODE_TEST_BINARY=* npx --no-install vitest*": "allow",
          "KIKI_RELEASE_TEST_OC2_REHEARSAL=1 npx --no-install vitest*": "allow",
          "npx --no-install tsc*": "allow",
          "node dist/cli/index.js verify*": "allow",
          "node dist/cli/index.js release": "allow",
          "node dist/cli/index.js release --bump major --since *": "allow",
          "node dist/cli/index.js release*--apply*": "deny"
        }
      },
      "model": "openrouter/z-ai/glm-5.3" //,
      //"model": "openrouter/z-ai/glm-5.3"
    },
    "kiki-escalation": {
      "permission": {
        "read": {
          "*": "allow",
          ".env*": "deny",
          "**/.env*": "deny",
          "**/*secret*": "deny",
          "**/*credential*": "deny",
          "**/*.pem": "deny",
          "**/*.key": "deny",
          "**/id_rsa*": "deny"
        },
        "edit": {
          "*": "deny",
          ".agentic/reviews/*": "allow",
          ".opencode/docs/reviews/*": "allow",
          ".worktree/**/.agentic/reviews/*": "allow",
          ".worktree/**/.opencode/docs/reviews/*": "allow"
        },
        "external_directory": {
          "/tmp/**": "allow",
          "tmp/**": "allow"
        },
        "bash": {
          "*": "deny",
          "git diff*": "allow",
          "git log*": "allow",
          "git status*": "allow",
          "git show*": "allow",
          "git ls-files*": "allow",
          "git rev-parse*": "allow",
          "git ls-tree*": "allow",
          "git rev-list*": "allow"
        }
      },
      "model": "openrouter/z-ai/glm-5.3" //,
      //"model": "openai/gpt-6.1-sol"
    },
    "kiki-historian": {
      "permission": {
        "read": {
          "*": "allow",
          ".env*": "deny",
          "**/.env*": "deny",
          "**/*secret*": "deny",
          "**/*credential*": "deny",
          "**/*.pem": "deny",
          "**/*.key": "deny",
          "**/id_rsa*": "deny"
        },
        "edit": {
          "*": "deny",
          "README*": "allow",
          "CHANGELOG*": "allow",
          "docs/**": "allow",
          ".agentic/**": "allow",
          ".worktree/**/README*": "allow",
          ".worktree/**/CHANGELOG*": "allow",
          ".worktree/**/docs/**": "allow",
          ".worktree/**/.agentic/**": "allow",
          "src/**": "deny",
          "tests/**": "deny",
          ".worktree/**/src/**": "deny",
          ".worktree/**/tests/**": "deny"
        },
        "bash": {
          "*": "deny",
          "git log*": "allow",
          "git diff*": "allow",
          "git status*": "allow",
          "git show*": "allow",
          "git ls-files*": "allow",
          "git rev-parse*": "allow",
          "git ls-tree*": "allow",
          "git rev-list*": "allow",
          "node dist/cli/index.js verify*": "allow"
        }
      }//,
      //"model": "deepseek/DeepSeek-V4.1-Flash-1017"
    }
  }
}
