{
  "$schema": "https://opencode.ai/config.json",
  "agent": {
    "kiki-orchestrator": {
      "model": "deepseek/deepseek-flash"
      //"model": "mistral/mistral-large-4"
    },
    "kiki-brainstormer": {
      "permission": {
        "read": {
          "*": "allow",
          ".env*": "deny",
          "**/.env*": "deny",
          "**/*secret*": "deny",
          "**/*credential*": "deny",
          "**/*.pem": "deny",
          "**/*.key": "deny",
          "**/id_rsa*": "deny"
        },
        "edit": {
          "*": "deny",
          "src/**": "deny",
          "tests/**": "deny",
          "docs/superpowers/**": "allow",
          "docs/superpowers/plans/**": "allow",
          "docs/superpowers/specs/**": "allow"
        },
        "bash": {
          "*": "deny",
          "git diff*": "allow",
          "git log*": "allow",
          "mkdir*": "allow"
        }
      }//,
      //"model": "mistral/mistral-large-4"
    },
    "kiki-planner": {
      "permission": {
        "read": {
          "*": "allow",
          ".env*": "deny",
          "**/.env*": "deny",
          "**/*secret*": "deny",
          "**/*credential*": "deny",
          "**/*.pem": "deny",
          "**/*.key": "deny",
          "**/id_rsa*": "deny"
        },
        "edit": {
          "*": "deny",
          "src/**": "deny",
          "tests/**": "deny",
          "docs/superpowers/**": "allow",
          "docs/superpowers/plans/**": "allow",
          "docs/superpowers/specs/**": "allow"
        },
        "bash": {
          "*": "deny",
          "git diff*": "allow",
          "git log*": "allow",
          "mkdir*": "allow"
        }
      }//,
      //"model": "openai/gpt-6.1-sol"
    },
    "kiki-implementer": {
      "permission": {
        "read": {
          "*": "allow",
          ".env*": "deny",
          "**/.env*": "deny",
          "**/*secret*": "deny",
          "**/*credential*": "deny",
          "**/*.pem": "deny",
          "**/*.key": "deny",
          "**/id_rsa*": "deny"
        },
        "edit": {
          "*": "deny",
          "docs/superpowers/**": "deny",
          "src/**": "allow",
          "tests/**": "allow",
          "/tmp/**": "allow",
          "tmp/**": "allow"
        },
        "external_directory": {
          "/tmp/**": "allow",
          "tmp/**": "allow"
        },
        "bash": "allow"
      }//,
      //"model": "deepseek/DeepSeek-V4.1-Flash-1017"
    },
    "kiki-gui-designer": {
      "permission": {
        "read": {
          "*": "allow",
          ".env*": "deny",
          "**/.env*": "deny",
          "**/*secret*": "deny",
          "**/*credential*": "deny",
          "**/*.pem": "deny",
          "**/*.key": "deny",
          "**/id_rsa*": "deny"
        },
        "edit": {
          "*": "deny",
          "docs/superpowers/**": "deny",
          "src/**": "allow",
          "tests/**": "allow",
          "/tmp/**": "allow",
          "tmp/**": "allow"
        },
        "external_directory": {
          "/tmp/**": "allow",
          "tmp/**": "allow"
        },
        "bash": "allow"
      }//,
      //"model": "openrouter/z-ai/glm-5.3"
    },
    "kiki-reviewer": {
      "permission": {
        "read": {
          "*": "allow",
          ".env*": "deny",
          "**/.env*": "deny",
          "**/*secret*": "deny",
          "**/*credential*": "deny",
          "**/*.pem": "deny",
          "**/*.key": "deny",
          "**/id_rsa*": "deny"
        },
        "edit": {
          "*": "deny",
          "src/**": "deny",
          "tests/**": "deny",
          "docs/**": "deny",
          ".agentic/reviews/*": "allow",
          ".opencode/docs/reviews/*": "allow"
        },
        "external_directory": {
          "/tmp/**": "allow",
          "tmp/**": "allow"
        },
        "bash": {
          "*": "deny",
          "git diff*": "allow",
          "git log*": "allow"
        }
      },
      "model": "openrouter/z-ai/glm-5.3" //,
      //"model": "openrouter/z-ai/glm-5.3"
    },
    "kiki-escalation": {
      "permission": {
        "read": {
          "*": "allow",
          ".env*": "deny",
          "**/.env*": "deny",
          "**/*secret*": "deny",
          "**/*credential*": "deny",
          "**/*.pem": "deny",
          "**/*.key": "deny",
          "**/id_rsa*": "deny"
        },
        "edit": {
          "*": "deny",
          ".agentic/reviews/*": "allow",
          ".opencode/docs/reviews/*": "allow"
        },
        "external_directory": {
          "/tmp/**": "allow",
          "tmp/**": "allow"
        },
        "bash": {
          "*": "deny",
          "git diff*": "allow",
          "git log*": "allow"
        }
      },
      "model": "openrouter/z-ai/glm-5.3" //,
      //"model": "openai/gpt-6.1-sol"
    },
    "kiki-historian": {
      "permission": {
        "read": {
          "*": "allow",
          ".env*": "deny",
          "**/.env*": "deny",
          "**/*secret*": "deny",
          "**/*credential*": "deny",
          "**/*.pem": "deny",
          "**/*.key": "deny",
          "**/id_rsa*": "deny"
        },
        "edit": {
          "*": "deny",
          "README*": "allow",
          "CHANGELOG*": "allow",
          "docs/**": "allow",
          ".agentic/**": "allow",
          "src/**": "deny",
          "tests/**": "deny"
        },
        "bash": {
          "*": "deny",
          "git log*": "allow",
          "git diff*": "allow"
        }
      }//,
      //"model": "deepseek/DeepSeek-V4.1-Flash-1017"
    }
  }
}
